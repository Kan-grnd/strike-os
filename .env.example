# PostgreSQL connection string.
#
# The datasource provider is `postgresql` for every environment, including
# local development. There is no SQLite fallback.
#
# The devcontainer's docker-compose service exposes this on the host as:
DATABASE_URL="postgresql://strike:strikeos@localhost:5432/strike_os?schema=public"

# In the devcontainer itself the host name is `db` rather than `localhost`.
# Do not add a second DATABASE_URL here: it would shadow the container's.
#
# For production, point this at a managed PostgreSQL provider and add the same
# variable in Vercel project settings. Never commit a real connection string.
