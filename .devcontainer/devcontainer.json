{
  "name": "Strike OS",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "postCreateCommand": "echo 'DATABASE_URL=\"file:./dev.db\"' > .env && npm ci && npx prisma generate && npx prisma db push",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Strike OS",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "remoteUser": "node"
}
